# INSM - Variables de entorno
# Este archivo NO debe contener credenciales reales.
# Para Vercel, las variables reales se cargan en:
# Project > Settings > Environment Variables
# =========================================================

# ---------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------
DB_HOST=TU_HOST_DE_BASE_DE_DATOS
DB_PORT=3306
DB_USER=TU_USUARIO_DB
DB_PASSWORD=TU_PASSWORD_DB
DB_NAME=inscripciones_db

# Producción: usar TLS/SSL si tu proveedor de DB lo soporta/requiere.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Dejar vacío si tu proveedor no necesita un CA personalizado.
DB_SSL_CA=

# Pool de conexiones
DB_CONNECTION_LIMIT=5
DB_MAX_IDLE=5
DB_IDLE_TIMEOUT_MS=60000

# ---------------------------------------------------------
# APLICACIÓN
# ---------------------------------------------------------
NODE_ENV=production

# URL exacta desde la que se accederá al sitio.
# Ejemplo:
# APP_URL=https://webescolar-web-escolar.vercel.app
APP_URL=https://TU-PROYECTO.vercel.app

# Año que manejará el formulario/API.
INSCRIPTION_YEAR=2027

# Se usa para firmar las sesiones administrativas.
# Debe ser un secreto largo y aleatorio en producción.
AUTH_SECRET=GENERAR_UN_SECRETO_LARGO_Y_ALEATORIO

# Duración de la sesión administrativa en segundos.
# 28800 = 8 horas
ADMIN_SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------
# AUTENTICACIÓN ADMINISTRATIVA
# ---------------------------------------------------------
# Usar el hash generado por:
# node scripts/hash-admin-password.js
#
# NO guardar aquí la contraseña en texto plano en producción.
ADMIN_PASSWORD_HASH=PEGAR_AQUI_EL_HASH_SCRYPT

# Sólo para desarrollo local.
# En Vercel/producción debe quedar desactivado o ausente.
# ALLOW_LOCAL_PLAINTEXT_ADMIN_PASSWORD=true

# Sólo desarrollo local, si se usa el modo anterior.
# ADMIN_PASSWORD=NO_USAR_EN_PRODUCCION

# ---------------------------------------------------------
# ALMACENAMIENTO DE DOCUMENTOS
# ---------------------------------------------------------
# Para Vercel usar Blob privado:
STORAGE_MODE=blob

# Vercel normalmente crea esta variable automáticamente
# al conectar un Blob Store al proyecto.
BLOB_READ_WRITE_TOKEN=SE_CONFIGURA_EN_VERCEL

# Para desarrollo local podría usarse:
# STORAGE_MODE=local

# ---------------------------------------------------------
# NOTAS
# ---------------------------------------------------------
# PORT no hace falta definirlo en Vercel.
# VERCEL tampoco hace falta definirlo manualmente:
# Vercel lo proporciona automáticamente.
"""